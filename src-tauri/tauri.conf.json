{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "回路 Circuit",
  "version": "1.0.0",
  "identifier": "com.aureliuswu.circuit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "回路 / Circuit",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Game",
    "shortDescription": "中式民俗恐怖叙事 AVG",
    "longDescription": "以城市配电抢修为入口的中式民俗恐怖叙事游戏。",
    "icon": [
      "icons/icon.ico",
      "icons/128x128.png"
    ]
  }
}
